---
import Icon from "../atoms/Icon.astro";

interface Props {
	label?: string;
}

const { label = "返回顶部" } = Astro.props;
---

<button
	class="scroll-top"
	type="button"
	data-scroll-top
	aria-label={label}
	title={label}
>
	<svg class="scroll-top__ring" viewBox="0 0 48 48" aria-hidden="true">
		<circle
			class="scroll-top__ring-track"
			cx="24"
			cy="24"
			r="21"
			pathLength="1"
		/>
		<circle
			class="scroll-top__ring-fill"
			cx="24"
			cy="24"
			r="21"
			pathLength="1"
		/>
	</svg>
	<span class="scroll-top__scan" aria-hidden="true"></span>
	<span class="scroll-top__mark" aria-hidden="true">
		<Icon name="arrow-up" size="1rem" />
	</span>
	<span class="scroll-top__label" aria-hidden="true">
		RETURN / TOP
	</span>
</button>
