---
import { motionConfig } from "../../config";

interface Props {
	class?: string;
	count?: number;
	variant?: "hero" | "section";
}

const { class: className = "", count = 40, variant = "hero" } = Astro.props;
const enabled = motionConfig.enabled && motionConfig.decor.particles;
---

{enabled && (
	<canvas
		class:list={["particle-field", `particle-field--${variant}`, className]}
		data-particles
		data-count={count}
		aria-hidden="true"
	/>
)}

<style>
	.particle-field {
		position: absolute;
		inset: 0;
		z-index: 1;
		width: 100%;
		height: 100%;
		color: var(--media-accent, var(--accent));
		opacity: 0.75;
		pointer-events: none;
	}

	@media (max-width: 767px) {
		.particle-field {
			display: none;
		}
	}
</style>
