---
import { motionConfig } from "../../config";

interface Props {
	class?: string;
	count?: number;
	variant?: "hero" | "section";
}

const { class: className = "", count = 40, variant = "hero" } = Astro.props;
const enabled = motionConfig.enabled && motionConfig.decor.particles;
---

{enabled && (
	<canvas
		class:list={["particle-field", `particle-field--${variant}`, className]}
		data-particles
		data-count={count}
		aria-hidden="true"
	/>
)}

<style>
	.particle-field {
		position: absolute;
		inset: 0;
		z-index: 1;
		width: 100%;
		height: 100%;
		color: var(--media-accent, var(--accent));
		opacity: 0.75;
		pointer-events: none;
	}

	/* 区块粒子只有几十个，铺满整屏意味着每帧清空上百万像素却几乎画不出东西。
	   收成局部方块，清屏面积降到约 1/8。 */
	.particle-field--section {
		inset: auto;
		top: 8%;
		right: 6%;
		width: min(38rem, 42vw);
		height: min(26rem, 38vh);
	}
</style>
