---
import Image from "../atoms/Image.astro";
import SpaceLines from "../atoms/SpaceLines.astro";
import HalftoneField from "../atoms/HalftoneField.astro";
import ContourField from "../atoms/ContourField.astro";
import RayField from "../atoms/RayField.astro";
import ParticleField from "../atoms/ParticleField.astro";
import { motionConfig } from "../../config";
import { resolveAsset } from "../../utils/assets";
import type {
	HomeSectionConfig,
	HomeSectionType,
	SectionDecor,
} from "../../types/config";

interface Props {
	section: HomeSectionConfig;
}

const { section } = Astro.props;
const hasImage = Boolean(section.image || section.video);

const defaultDecor: Record<HomeSectionType, SectionDecor> = {
	intro: "halftone",
	history: "contour",
	news: "halftone",
	contact: "rays",
	products: "rays",
};

const decor = section.decor ?? defaultDecor[section.type];
const showDecor = motionConfig.enabled;
const showMatrix = showDecor && decor !== "halftone";
const mediaClass = hasImage
	? section.overlay === "dark"
		? "on-media"
		: section.overlay === "light"
			? "on-light"
			: ""
	: "";
---

<section
	class:list={[
		"snap-section",
		"home-section",
		hasImage && "home-section--image",
		`home-section--overlay-${section.overlay}`,
		mediaClass,
		!section.fullHeight && "home-section--auto",
	]}
	id={section.id}
	aria-labelledby={`${section.id}-title`}
>
	{hasImage && (
		<>
			{section.video ? (
				<video
					class="home-section__bg home-section__bg--video"
					src={resolveAsset(section.video)}
					poster={resolveAsset(section.image)}
					autoplay
					muted
					loop
					playsinline
					preload="metadata"
					aria-hidden="true"
				/>
			) : (
				<Image
					src={section.image}
					alt={section.imageAlt}
					class="home-section__bg"
					loading="lazy"
					style={`object-position: ${section.imagePosition}`}
				/>
			)}
			<div
				class:list={[
					"home-section__overlay",
					`home-section__overlay--${section.overlay}`,
				]}
				aria-hidden="true"
			/>
			<div class="home-section__grain" aria-hidden="true" />
			<span class="home-section__sheen" aria-hidden="true" />
		</>
	)}
	{showDecor && section.type === "intro" && (
		<ParticleField variant="section" count={28} />
	)}
	<span class="home-section__chapter" aria-hidden="true">
		<span class="home-section__chapter-line"></span>
	</span>
	<SpaceLines ambient />
	<span class="home-section__grid" aria-hidden="true" />
	<span class="section-spotlight" aria-hidden="true" />
	{showDecor && decor === "halftone" && <HalftoneField />}
	{showDecor && decor === "contour" && <ContourField variant="section" />}
	{showDecor && decor === "rays" && <RayField position="right" />}
	{showDecor && section.type === "intro" && (
		<ContourField variant="section" opacity={0.2} />
	)}
	{showDecor && section.type === "history" && (
		<HalftoneField position="bottom-left" opacity={0.26} />
	)}
	{showDecor && section.type === "contact" && (
		<HalftoneField position="bottom-left" opacity={0.26} />
	)}
	{showDecor && section.type === "products" && (
		<HalftoneField position="bottom-left" opacity={0.26} />
	)}
	{showMatrix && <span class="home-section__matrix" aria-hidden="true" />}
	<div class="container home-section__inner">
		<slot />
	</div>
</section>
