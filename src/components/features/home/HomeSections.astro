---
import { homeConfig } from "../../../config";
import type { HomeSectionType } from "../../../types/config";
import ContactSection from "./ContactSection.astro";
import HistorySection from "./HistorySection.astro";
import IntroSection from "./IntroSection.astro";
import NewsSection from "./NewsSection.astro";
import ProductsSection from "./ProductsSection.astro";

const sections = homeConfig.sections.filter((section) => section.enabled);

const components: Record<HomeSectionType, any> = {
	intro: IntroSection,
	history: HistorySection,
	news: NewsSection,
	contact: ContactSection,
	products: ProductsSection,
};
---

{sections.map((section) => {
	const Component = components[section.type];
	return <Component section={section} />;
})}
