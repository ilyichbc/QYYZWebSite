---
import Barcode from "../../components/atoms/Barcode.astro";
import Image from "../../components/atoms/Image.astro";
import SpaceLines from "../../components/atoms/SpaceLines.astro";
import ButtonLink from "../../components/atoms/ButtonLink.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import { productsConfig, siteConfig } from "../../config";
import { withBase } from "../../utils/assets";
import type { ProductItem } from "../../types/config";

export function getStaticPaths() {
	if (!siteConfig.page.products.enabled) {
		return [];
	}

	return productsConfig.items
		.filter((item) => item.enabled && item.slug)
		.map((item) => ({
			params: { slug: item.slug },
			props: { item },
		}));
}

interface Props {
	item: ProductItem;
}

const { item } = Astro.props;
const detail = item.detail;
const meta = ["LUMINOA", ...(item.tags ?? [])];
---

<PageLayout
	title={item.title}
	description={item.description}
	eyebrow="// LUMINOA PRODUCT"
	heroTitle={item.title}
	lead={item.description}
	latin={item.latin.toUpperCase()}
	index={item.index}
	meta={meta}
	hero={{
		image: item.heroImage || productsConfig.hero.image,
		imageAlt: item.heroImage
			? `${item.title} 头图`
			: productsConfig.hero.imageAlt,
		imagePosition: productsConfig.hero.imagePosition,
		overlay: productsConfig.hero.overlay,
	}}
>
	<section class="product-detail">
		<SpaceLines variant="section" />

		<div class="container product-detail__layout">
			<aside class="product-detail__aside" data-reveal>
				<div class="product-detail__media">
					<Image
						src={item.image}
						alt={item.imageAlt}
						width={1200}
						height={720}
						class="product-detail__logo"
					/>
				</div>

				<div class="product-detail__facts">
					<div class="product-detail__fact">
						<span class="meta-field">STATUS</span>
						<span>{item.status || "—"}</span>
					</div>
					<div class="product-detail__fact">
						<span class="meta-field">PLATFORMS</span>
						<span>{item.tags?.join(" / ") || "—"}</span>
					</div>
				</div>

				<Barcode
					class="product-detail__barcode"
					seed={item.slug || item.id}
					label={`LUMINOA / ${item.index}`}
					height={18}
					count={30}
				/>

				{detail?.sourceHref && (
					<ButtonLink
						href={detail.sourceHref}
						variant="ghost"
						external
					>
						{detail.sourceLabel || "访问官网"}
					</ButtonLink>
				)}
			</aside>

			<div class="product-detail__content">
				<section
					class="product-detail__block"
					data-reveal
					style="--reveal-delay: 80ms"
				>
					<p class="eyebrow">// ABOUT THE GAME</p>
					<h2 class="product-detail__heading">游戏描述</h2>
					{detail?.description?.map((paragraph) => (
						<p class="product-detail__text">{paragraph}</p>
					))}
				</section>

				{detail?.characters && detail.characters.length > 0 && (
					<section
						class="product-detail__block"
						data-reveal
						style="--reveal-delay: 140ms"
					>
						<p class="eyebrow">// CHARACTERS</p>
						<h2 class="product-detail__heading">角色介绍</h2>
						<div class="character-grid">
							{detail.characters.map((character) => (
								<article class="character-card">
									<span class="character-card__index">
										{character.name}
									</span>
									{character.tags && (
										<span class="tag">
											{character.tags}
										</span>
									)}
									{character.description && (
										<p class="character-card__desc">
											{character.description}
										</p>
									)}
								</article>
							))}
						</div>
					</section>
				)}

				{detail?.downloads && detail.downloads.length > 0 && (
					<section
						class="product-detail__block"
						data-reveal
						style="--reveal-delay: 200ms"
					>
						<p class="eyebrow">// DOWNLOAD</p>
						<h2 class="product-detail__heading">下载游戏</h2>
						{detail.downloadNote && (
							<p class="product-detail__text">
								{detail.downloadNote}
							</p>
						)}
						<div class="download-grid">
							{detail.downloads.map((download) => (
								<a
									class="download-link"
									href={download.href}
									target={
										download.external ? "_blank" : undefined
									}
									rel={
										download.external
											? "noopener noreferrer"
											: undefined
									}
								>
									<span class="download-link__label">
										{download.label}
									</span>
									{download.note && (
										<span class="download-link__note">
											{download.note}
										</span>
									)}
									<span
										class="download-link__arrow"
										aria-hidden="true"
									>
										↗
									</span>
								</a>
							))}
						</div>
					</section>
				)}

				{detail?.creditsNote && (
					<section
						class="product-detail__block"
						data-reveal
						style="--reveal-delay: 260ms"
					>
						<p class="eyebrow">// CREDITS</p>
						<h2 class="product-detail__heading">制作人员</h2>
						<p class="product-detail__text">{detail.creditsNote}</p>
						{detail.sourceHref && (
							<a
								class="link-more"
								href={detail.sourceHref}
								target="_blank"
								rel="noopener noreferrer"
							>
								{detail.sourceLabel || "访问官网"}
							</a>
						)}
					</section>
				)}

				<a class="link-more" href={withBase("/products/")}>
					返回所有产品
				</a>
			</div>
		</div>
	</section>
</PageLayout>

<style>
	.product-detail {
		position: relative;
		overflow: hidden;
		padding-block: clamp(3rem, 7vw, 6rem);
		background: var(--paper);
	}

	.product-detail__layout {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: minmax(16rem, 0.75fr) minmax(0, 1.25fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: start;
	}

	.product-detail__aside {
		display: flex;
		flex-direction: column;
		gap: 1.2rem;
	}

	.product-detail__media {
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 10;
		border: 1px solid var(--line);
		background: var(--panel);
	}

	.product-detail__logo {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.product-detail__facts {
		border-top: 1px solid var(--line);
	}

	:global(.product-detail__barcode) {
		align-self: flex-start;
		opacity: 0.42;
	}

	.product-detail__fact {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.65rem;
		border-bottom: 1px solid var(--line);
		color: var(--ink-soft);
		font-size: 0.82rem;
	}

	.product-detail__content {
		display: flex;
		flex-direction: column;
		gap: clamp(2rem, 5vw, 3.5rem);
		max-width: 46rem;
	}

	.product-detail__block {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}

	.product-detail__heading {
		margin: 0;
		color: var(--ink);
		font-size: clamp(1.45rem, 2.6vw, 2rem);
		line-height: 1.25;
	}

	.product-detail__text {
		color: var(--ink-soft);
		font-size: 0.98rem;
		line-height: 1.95;
	}

	.character-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.8rem;
	}

	.character-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.55rem;
		padding: 1rem;
		border: 1px solid var(--line);
		background: var(--panel);
	}

	.character-card__index {
		color: var(--ink);
		font-size: 1.1rem;
		font-weight: 700;
	}

	.character-card__desc {
		color: var(--muted);
		font-size: 0.8rem;
		line-height: 1.7;
	}

	.download-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.8rem;
	}

	.download-link {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 1rem;
		border: 1px solid var(--line);
		background: var(--panel);
		transition:
			border-color var(--dur-base) var(--ease-mech),
			background var(--dur-base) var(--ease-mech);
	}

	.download-link:hover {
		border-color: var(--line-strong);
		background: color-mix(in srgb, var(--accent) 4%, var(--panel));
	}

	.download-link__label {
		color: var(--ink);
		font-weight: 600;
	}

	.download-link__note {
		color: var(--muted);
		font-size: 0.74rem;
	}

	.download-link__arrow {
		position: absolute;
		top: 0.8rem;
		right: 0.8rem;
		color: var(--muted);
	}

	@media (max-width: 900px) {
		.product-detail__layout {
			grid-template-columns: minmax(0, 1fr);
		}

		.product-detail__content {
			max-width: none;
		}
	}

	@media (max-width: 560px) {
		.character-grid,
		.download-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
