---
import { siteConfig, themeConfig } from "../../config";
import { absoluteUrl, resolveAsset, withBase } from "../../utils/assets";
import { buildThemeCss, buildThemeInitScript } from "../../utils/theme";

interface ArticleMeta {
	published: Date;
	updated?: Date;
	author?: string;
}

interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
	type?: "website" | "article";
	article?: ArticleMeta;
}

const {
	title = siteConfig.identity.name,
	description = siteConfig.identity.description,
	image = siteConfig.seo.ogImage,
	noindex = false,
	type = "website",
	article,
} = Astro.props;

const isHome = title === siteConfig.identity.name;
const pageTitle = isHome
	? `${siteConfig.identity.name} ${siteConfig.identity.nameLatin} — ${siteConfig.identity.tagline}`
	: siteConfig.seo.titleTemplate.replace("%s", title);

const canonical = new URL(Astro.url.pathname, siteConfig.siteURL).toString();
const ogImage = absoluteUrl(resolveAsset(image), siteConfig.siteURL);
const themeCss = buildThemeCss();
const themeInitScript = buildThemeInitScript();
const favicon = resolveAsset("/favicon.svg");

const structuredData = {
	"@context": "https://schema.org",
	"@type": type === "article" ? "BlogPosting" : "WebSite",
	name: pageTitle,
	headline: pageTitle,
	description,
	url: canonical,
	image: ogImage,
	inLanguage: siteConfig.lang,
	publisher: {
		"@type": "Organization",
		name: siteConfig.identity.name,
		url: absoluteUrl(withBase("/"), siteConfig.siteURL),
	},
	...(article
		? {
				datePublished: article.published.toISOString(),
				dateModified: (
					article.updated ?? article.published
				).toISOString(),
				author: {
					"@type": "Person",
					name: article.author ?? siteConfig.identity.name,
				},
			}
		: {}),
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
{isHome && <meta name="keywords" content={siteConfig.keywords.join(", ")} />}
<meta
	name="robots"
	content={noindex ? "noindex, nofollow" : siteConfig.seo.robots}
/>
<link rel="canonical" href={canonical} />
<link rel="icon" href={favicon} type="image/svg+xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${siteConfig.identity.name} RSS`}
	href={absoluteUrl(withBase("/rss.xml"), siteConfig.siteURL)}
/>

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.identity.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={siteConfig.identity.name} />
<meta property="og:locale" content={siteConfig.locale} />
{article && (
	<meta
		property="article:published_time"
		content={article.published.toISOString()}
	/>
)}
{article?.updated && (
	<meta
		property="article:modified_time"
		content={article.updated.toISOString()}
	/>
)}

<meta name="twitter:card" content={siteConfig.seo.twitterCard} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta
	name="theme-color"
	content={themeConfig.light.paper}
	media="(prefers-color-scheme: light)"
/>
<meta
	name="theme-color"
	content={themeConfig.dark.paper}
	media="(prefers-color-scheme: dark)"
/>
<meta name="generator" content={Astro.generator} />

<script is:inline set:html={themeInitScript} />
<style is:inline set:html={themeCss}></style>
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
<slot name="head" />
