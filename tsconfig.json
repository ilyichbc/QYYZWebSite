{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"],
			"@components/*": ["src/components/*"],
			"@layouts/*": ["src/layouts/*"],
			"@utils/*": ["src/utils/*"],
			"@types/*": ["src/types/*"],
			"@config": ["src/config.ts"]
		}
	},
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist", "node_modules", "plugin"]
}
