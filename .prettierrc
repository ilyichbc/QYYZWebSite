{
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 80,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"bracketSpacing": true,
	"arrowParens": "always",
	"endOfLine": "lf",
	"plugins": ["prettier-plugin-astro"],
	"overrides": [
		{
			"files": ["*.astro"],
			"options": {
				"parser": "astro"
			}
		},
		{
			"files": ["*.css"],
			"options": {
				"useTabs": false,
				"tabWidth": 2,
				"printWidth": 200
			}
		},
		{
			"files": ["*.md"],
			"options": {
				"useTabs": false,
				"tabWidth": 2,
				"printWidth": 100
			}
		}
	]
}
